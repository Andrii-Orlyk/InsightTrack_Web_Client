# InsightTrack Web Client environment template
# Copy to .env for local development: cp .env.example .env

# Demo/mock mode (default review path)
VITE_USE_MOCK_API=true

# Live API-ready base URLs (used when mock mode is disabled)
VITE_INSIGHTTRACK_API_BASE_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# Public environment label
VITE_APP_ENV=development
